# 统一换行符，避免 Windows/macOS 协作时整文件 diff
* text=auto eol=lf

# 二进制文件不要做换行符转换
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.wasm binary

# 自动生成的文件，折叠在 GitHub 的 diff 里
package-lock.json linguist-generated=true
drizzle/meta/*_snapshot.json linguist-generated=true
data/holidays.json linguist-generated=true
