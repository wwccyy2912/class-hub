{
  "name": "class-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "sync:holidays": "node scripts/sync-holidays.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:browser": "node tests/browser/network.mjs && node tests/browser/chat.mjs && node tests/browser/accounts.mjs && node tests/browser/icons.mjs",
    "package": "node scripts/package.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:migrate": "wrangler d1 migrations apply DB --remote",
    "whoami": "wrangler whoami"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.0",
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "drizzle-kit": "^0.31.0",
    "wrangler": "^4.0.0"
  },
  "version": "1.0.0",
  "description": "班级信息资源共享网站：资料站点、课程表、日历与调休、班级聊天、用户组权限，部署在 Cloudflare Workers + D1 + R2",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/wwccyy2912/class-hub.git"
  },
  "bugs": {
    "url": "https://github.com/wwccyy2912/class-hub/issues"
  }
}
